{
  "name": "tecnistock",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "predev": "node -e \"require('fs').existsSync('dist/client/index.html')||require('child_process').execSync('npm run build:vite --prefix frontend',{stdio:'inherit'})\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "node scripts/build-frontend.mjs",
    "build:vite": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/interprete-busqueda.test.ts src/lib/orquestador-intencion.test.ts src/lib/cuenta-abierta.test.ts",
    "seed:inventario-local": "node scripts/cargar-inventario-local.mjs",
    "seed:fotos": "node scripts/vincular-fotos-inventario.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "hono": "^4.9.8",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.28.0"
  }
}
